# HTTP/WebSocket listening port (injected automatically by Render, Railway, Fly.io, Cloud Run)
PORT=8080
HOST=0.0.0.0

# Room expiration TTL in milliseconds (default: 6 hours = 21600000)
ROOM_TTL_MS=21600000

# Host disconnect grace window before automatic host transfer (ms, default: 20000)
HOST_TRANSFER_GRACE_MS=20000

# Disconnected participant eviction window (ms, default: 60000)
PARTICIPANT_DISCONNECT_GRACE_MS=60000

# Empty room cleanup grace window (ms, default: 300000)
EMPTY_ROOM_GRACE_MS=300000

# Per-IP rate limiting
MAX_CONNECTIONS_PER_IP=20
MAX_UPGRADES_PER_MIN_PER_IP=60

# Optional comma-separated allowed browser origins (native Android clients do not send Origin)
ALLOWED_ORIGINS=

# Optional shared API key required in x-api-key header (leave blank for public room-code access)
LISTEN_TOGETHER_API_KEY=
